        <file alias="defaults/Character/Config/config.json">default_config/AkiDesk/Character/Config/config.json</file>
        <file alias="defaults/Plugin/Anime/Basic Animation Package.json">default_config/AkiDesk/Plugin/Anime/Basic Animation Package.json</file>
